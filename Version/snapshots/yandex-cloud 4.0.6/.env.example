# Секреты Cloud Function (не коммитить реальные значения в git с продом)
# В консоли YC: Функция → Редактировать → Переменные окружения

YANDEX_API_KEY=
STATS_SECRET=da_cppk_stats_view_2026
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pomoshnikcppk@t.me

# Базовая защита клиента (совпадает с app/js/app-config.js → yandexClientToken)
CLIENT_GATE_TOKEN=da_cppk_client_2026_web
# Опционально, через запятую (по умолчанию: GitHub Pages + localhost:8765/8790)
# ALLOWED_ORIGINS=https://centralppk-tools.github.io,http://127.0.0.1:8765,http://localhost:8765

# Yandex Object Storage (S3). Без бакета кэш только в памяти инстанса.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_PREFIX=da-cache/
