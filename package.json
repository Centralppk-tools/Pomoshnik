{
  "scripts": {
    "serve": "node tools/encode-secrets.mjs && python -m http.server 8765 --directory app",
    "secrets:encode": "node tools/encode-secrets.mjs",
    "build": "node tools/build.mjs",
    "export:shifts": "python tools/export-shifts.py",
    "enrich:train-uids": "python tools/enrich-train-uids.py",
    "snapshot": "node tools/snapshot.mjs",
    "release": "node tools/build.mjs && node tools/snapshot.mjs",
    "clasp:push": "clasp push --force",
    "clasp:deploy": "node -e \"console.error('Use manual Web App deploy in script.google.com — clasp deploy breaks /exec. See google-script/README-DEPLOY.txt'); process.exit(1)\"",
    "clasp:cleanup-deployments": "node tools/clasp-cleanup-deployments.mjs",
    "clasp:release": "npm run clasp:push"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0"
  }
}
